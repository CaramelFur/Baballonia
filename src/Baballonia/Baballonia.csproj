	<!--
	  Regenerate Resources.Designer.cs from Resources.resx before each compilation.
	  This replaces the Visual Studio "Run Custom Tool" step so that
	  'dotnet build' works on any platform without needing VS.
	-->
	<UsingTask
	  TaskName="GenerateStronglyTypedResources"
	  TaskFactory="RoslynCodeTaskFactory"
	  AssemblyFile="$(RoslynCodeTaskFactoryAssembly)">
	  <ParameterGroup>
	    <ResxPath ParameterType="System.String" Required="true" />
	    <OutputPath ParameterType="System.String" Required="true" />
	    <Namespace ParameterType="System.String" Required="true" />
	    <ClassName ParameterType="System.String" Required="true" />
	    <ManifestPrefix ParameterType="System.String" Required="true" />
	    <PublicClass ParameterType="System.Boolean" Required="true" />
	  </ParameterGroup>
	  <Task>
	    <Using Namespace="System.IO" />
	    <Using Namespace="System.Text" />
	    <Using Namespace="System.Text.RegularExpressions" />
	    <Using Namespace="System.Xml.Linq" />
	    <Code Type="Fragment" Language="cs"><![CDATA[
var doc = XDocument.Load(ResxPath);
var entries = new System.Collections.Generic.List<(string Name, string Value)>();
foreach (var data in doc.Root!.Elements("data"))
{
    var typeAttr = data.Attribute("type");
    if (typeAttr != null) continue;
    var name = (string?)data.Attribute("name") ?? "";
    var value = (string?)data.Element("value") ?? "";
    entries.Add((name, value));
}
entries.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.Ordinal));

static string ToPropName(string n)
{
    var sb = new StringBuilder();
    foreach (var c in n) sb.Append(char.IsLetterOrDigit(c) || c == '_' ? c : '_');
    var s = sb.ToString();
    return s.Length > 0 && char.IsDigit(s[0]) ? "_" + s : s;
}

static string EscapeSummary(string v)
{
    v = v.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;");
    return v.Length > 512 ? v.Substring(0, 512) : v;
}

var sb2 = new StringBuilder();
sb2.AppendLine("\ufeff//------------------------------------------------------------------------------");
sb2.AppendLine("// <auto-generated>");
sb2.AppendLine("//     This code was generated by a tool.");
sb2.AppendLine("//     Runtime Version:4.0.30319.42000");
sb2.AppendLine("//");
sb2.AppendLine("//     Changes to this file may cause incorrect behavior and will be lost if");
sb2.AppendLine("//     the code is regenerated.");
sb2.AppendLine("// </auto-generated>");
sb2.AppendLine("//------------------------------------------------------------------------------");
sb2.AppendLine();
sb2.AppendLine($"namespace {Namespace} {{");
sb2.AppendLine("    using System;");
sb2.AppendLine("    ");
sb2.AppendLine("    ");
sb2.AppendLine("    /// <summary>");
sb2.AppendLine("    ///   A strongly-typed resource class, for looking up localized strings, etc.");
sb2.AppendLine("    /// </summary>");
sb2.AppendLine("    // This class was auto-generated by the StronglyTypedResourceBuilder");
sb2.AppendLine("    // class via a tool like ResGen or Visual Studio.");
sb2.AppendLine("    // To add or remove a member, edit your .ResX file then rerun ResGen");
sb2.AppendLine("    // with the /str option, or rebuild your VS project.");
sb2.AppendLine("    [global::System.CodeDom.Compiler.GeneratedCodeAttribute(\"System.Resources.Tools.StronglyTypedResourceBuilder\", \"17.0.0.0\")]");
sb2.AppendLine("    [global::System.Diagnostics.DebuggerNonUserCodeAttribute()]");
sb2.AppendLine("    [global::System.Runtime.CompilerServices.CompilerGeneratedAttribute()]");
var accessMod = PublicClass ? "public" : "internal";
sb2.AppendLine($"    {accessMod} class {ClassName} {{");
sb2.AppendLine("        ");
sb2.AppendLine("        private static global::System.Resources.ResourceManager resourceMan;");
sb2.AppendLine("        ");
sb2.AppendLine("        private static global::System.Globalization.CultureInfo resourceCulture;");
sb2.AppendLine("        ");
sb2.AppendLine("        [global::System.Diagnostics.CodeAnalysis.SuppressMessageAttribute(\"Microsoft.Performance\", \"CA1811:AvoidUncalledPrivateCode\")]");
sb2.AppendLine($"        internal {ClassName}() {{");
sb2.AppendLine("        }");
sb2.AppendLine("        ");
sb2.AppendLine("        /// <summary>");
sb2.AppendLine("        ///   Returns the cached ResourceManager instance used by this class.");
sb2.AppendLine("        /// </summary>");
sb2.AppendLine("        [global::System.ComponentModel.EditorBrowsableAttribute(global::System.ComponentModel.EditorBrowsableState.Advanced)]");
sb2.AppendLine("        public static global::System.Resources.ResourceManager ResourceManager {");
sb2.AppendLine("            get {");
sb2.AppendLine("                if (object.ReferenceEquals(resourceMan, null)) {");
sb2.AppendLine($"                    global::System.Resources.ResourceManager temp = new global::System.Resources.ResourceManager(\"{ManifestPrefix}\", typeof({ClassName}).Assembly);");
sb2.AppendLine("                    resourceMan = temp;");
sb2.AppendLine("                }");
sb2.AppendLine("                return resourceMan;");
sb2.AppendLine("            }");
sb2.AppendLine("        }");
sb2.AppendLine("        ");
sb2.AppendLine("        /// <summary>");
sb2.AppendLine("        ///   Overrides the current thread's CurrentUICulture property for all");
sb2.AppendLine("        ///   resource lookups using this strongly typed resource class.");
sb2.AppendLine("        /// </summary>");
sb2.AppendLine("        [global::System.ComponentModel.EditorBrowsableAttribute(global::System.ComponentModel.EditorBrowsableState.Advanced)]");
sb2.AppendLine("        public static global::System.Globalization.CultureInfo Culture {");
sb2.AppendLine("            get {");
sb2.AppendLine("                return resourceCulture;");
sb2.AppendLine("            }");
sb2.AppendLine("            set {");
sb2.AppendLine("                resourceCulture = value;");
sb2.AppendLine("            }");
sb2.AppendLine("        }");
sb2.AppendLine("        ");
foreach (var (name, value) in entries)
{
    var propName = ToPropName(name);
    sb2.AppendLine("        /// <summary>");
    sb2.AppendLine($"        ///   Looks up a localized string similar to {EscapeSummary(value)}.");
    sb2.AppendLine("        /// </summary>");
    sb2.AppendLine($"        public static string {propName} {{");
    sb2.AppendLine("            get {");
    sb2.AppendLine($"                return ResourceManager.GetString(\"{name}\", resourceCulture);");
    sb2.AppendLine("            }");
    sb2.AppendLine("        }");
    sb2.AppendLine("        ");
}
sb2.AppendLine("    }");
sb2.AppendLine("}");

File.WriteAllText(OutputPath, sb2.ToString(), new UTF8Encoding(true));
]]></Code>
	  </Task>
	</UsingTask>

	<Target Name="GenerateResourcesDesigner" BeforeTargets="BeforeCompile;CoreCompile">
	  <GenerateStronglyTypedResources
	    ResxPath="$(MSBuildThisFileDirectory)Assets\Resources.resx"
	    OutputPath="$(MSBuildThisFileDirectory)Assets\Resources.Designer.cs"
	    Namespace="Baballonia.Assets"
	    ClassName="Resources"
	    ManifestPrefix="Baballonia.Assets.Resources"
	    PublicClass="true" />
	</Target>

